#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
for candidate in \
  "$SCRIPT_DIR/../lib/kbd-ambient-lib.sh" \
  "$HOME/.local/lib/kbd-ambient-lib.sh" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/kbd-ambient/kbd-ambient-lib.sh"
do
  if [[ -f "$candidate" ]]; then
    # shellcheck source=/dev/null
    source "$candidate"
    break
  fi
done
if ! declare -F kbd_ambient_set_defaults >/dev/null; then
  echo "kbd-ambientd: cannot find kbd-ambient-lib.sh" >&2
  exit 1
fi

DRY_RUN=0
[[ "${1:-}" == "--dry-run" ]] && DRY_RUN=1

kbd_ambient_set_defaults
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-samsung-kbd-backlight"
kbd_ambient_load_config "$CONFIG_DIR/config"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/kbd-ambientd"
mkdir -p "$RUNTIME_DIR"
echo $$ >"$RUNTIME_DIR/pid"
echo "ACTIVE_AUTO" >"$RUNTIME_DIR/state"
echo 0 >"$RUNTIME_DIR/manual_until"
printf '%s\n' "$(date +%s)" >"$RUNTIME_DIR/last_input"
echo "" >"$RUNTIME_DIR/last_set_brightness"

SYS_ROOT=/sys
KBD_DEV=$(kbd_ambient_discover_kbd "$SYS_ROOT") || {
  echo "kbd-ambientd: no *kbd_backlight* LED found" >&2
  exit 0
}
ALS_DEV=$(kbd_ambient_discover_als "$SYS_ROOT") || {
  echo "kbd-ambientd: no IIO illuminance (ALS) found" >&2
  exit 0
}

log() { echo "kbd-ambientd: $*" >&2; }

apply_brightness() {
  local level="$1"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run set $KBD_DEV -> $level"
    echo "$level" >"$RUNTIME_DIR/last_set_brightness"
    return 0
  fi
  if brightnessctl -d "$KBD_DEV" set "$level" >/dev/null; then
    echo "$level" >"$RUNTIME_DIR/last_set_brightness"
  else
    log "brightnessctl failed for level $level"
  fi
}

read_hw_brightness() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    cat "$RUNTIME_DIR/last_set_brightness" 2>/dev/null || echo 0
    return
  fi
  brightnessctl -d "$KBD_DEV" get
}

# Atomic last_input write: open("w") truncates before write; a concurrent reader
# can see an empty file and treat it as epoch 0 (false multi-year idle).
write_last_input() {
  local ts="${1:-$(date +%s)}"
  local tmp="$RUNTIME_DIR/last_input.tmp.$$"
  printf '%s\n' "$ts" >"$tmp" && mv -f "$tmp" "$RUNTIME_DIR/last_input"
}

read_last_input() {
  local raw now
  now=$(date +%s)
  raw=$(cat "$RUNTIME_DIR/last_input" 2>/dev/null || true)
  raw="${raw//$'\n'/}"
  raw="${raw// /}"
  if [[ "$raw" =~ ^[0-9]+$ ]] && (( raw > 1000000000 && raw < now + 3600 )); then
    echo "$raw"
  else
    echo "$now"
  fi
}

start_idle_watcher() {
  if command -v libinput >/dev/null; then
    (
      stdbuf -oL libinput debug-events 2>/dev/null | while IFS= read -r _line; do
        write_last_input
      done
    ) &
    echo $! >"$RUNTIME_DIR/idle_watcher_pid"
    return 0
  fi
  # Fallback: watch /dev/input for KEY/REL/ABS (user must be in group input)
  if command -v python3 >/dev/null; then
    (
      python3 - "$RUNTIME_DIR/last_input" <<'PY'
import glob, os, select, struct, sys, time
path = sys.argv[1]
tmp = path + ".tmp"
fmt = "llHHi"
size = struct.calcsize(fmt)
fds = []
for p in sorted(glob.glob("/dev/input/event*")):
    try:
        fds.append(open(p, "rb", buffering=0))
    except OSError:
        pass
if not fds:
    sys.exit(0)

def touch():
    # Write temp then rename so readers never see a truncated empty file.
    data = str(int(time.time())) + "\n"
    tpath = tmp + "." + str(os.getpid())
    try:
        with open(tpath, "w") as out:
            out.write(data)
        os.replace(tpath, path)
    except OSError:
        try:
            os.unlink(tpath)
        except OSError:
            pass

while True:
    r, _, _ = select.select(fds, [], [], 1.0)
    for f in r:
        data = f.read(size)
        if not data or len(data) < size:
            continue
        _s, _us, typ, _code, _val = struct.unpack(fmt, data)
        if typ in (1, 2, 3):  # EV_KEY, EV_REL, EV_ABS
            touch()
PY
    ) &
    echo $! >"$RUNTIME_DIR/idle_watcher_pid"
    log "idle watcher: python /dev/input fallback"
    return 0
  fi
  log "no libinput or python3; idle-off disabled"
}

cleanup() {
  if [[ -f "$RUNTIME_DIR/idle_watcher_pid" ]]; then
    kill "$(cat "$RUNTIME_DIR/idle_watcher_pid")" 2>/dev/null || true
  fi
  rm -f "$RUNTIME_DIR/pid"
}
trap cleanup EXIT INT TERM

start_idle_watcher

current_level=""
pre_idle_level=""
declare -a lux_hist=()
als_fail_since=0

# While lights are off for idle, block until last_input changes (or timeout).
wait_while_idle() {
  if command -v inotifywait >/dev/null; then
    # Directory watch: atomic replace of last_input is moved_to/create, not modify-on-inode.
    inotifywait -qq -t 1 -e moved_to,create,close_write "$RUNTIME_DIR" 2>/dev/null || true
  else
    sleep 0.15
  fi
}

log "kbd=$KBD_DEV als=$ALS_DEV dry_run=$DRY_RUN"

while true; do
  now=$(date +%s)
  manual_until=$(cat "$RUNTIME_DIR/manual_until" 2>/dev/null || echo 0)
  last_input=$(read_last_input)
  state=$(cat "$RUNTIME_DIR/state" 2>/dev/null || echo ACTIVE_AUTO)

  hw=$(read_hw_brightness)
  last_set=$(cat "$RUNTIME_DIR/last_set_brightness" 2>/dev/null || echo "")
  if [[ -n "$last_set" && "$hw" != "$last_set" && "$state" != "MANUAL_PAUSE" && "$state" != "IDLE_OFF" ]]; then
    manual_until=$((now + KBD_AMBIENT_MANUAL_PAUSE_SEC))
    echo "$manual_until" >"$RUNTIME_DIR/manual_until"
    echo "MANUAL_PAUSE" >"$RUNTIME_DIR/state"
    # Accept hardware level as the new baseline so resume does not re-trigger.
    echo "$hw" >"$RUNTIME_DIR/last_set_brightness"
    state=MANUAL_PAUSE
    current_level=$hw
    log "manual override detected hw=$hw pause until $manual_until"
  fi

  if [[ "$state" == "MANUAL_PAUSE" ]]; then
    if (( now >= manual_until )); then
      echo "ACTIVE_AUTO" >"$RUNTIME_DIR/state"
      state=ACTIVE_AUTO
      hw=$(read_hw_brightness)
      echo "$hw" >"$RUNTIME_DIR/last_set_brightness"
      current_level=$hw
      log "manual pause ended"
    else
      [[ "$DRY_RUN" -eq 1 ]] && log "state=$state lux=? level=hold"
      sleep "$KBD_AMBIENT_POLL_INTERVAL_SEC"
      continue
    fi
  fi

  idle_for=$((now - last_input))
  if (( idle_for < 0 )); then idle_for=0; fi
  if (( idle_for >= KBD_AMBIENT_IDLE_TIMEOUT_SEC )); then
    if [[ "$state" != "IDLE_OFF" ]]; then
      echo "IDLE_OFF" >"$RUNTIME_DIR/state"
      state=IDLE_OFF
      # Remember level to restore instantly on first key/mouse event.
      if [[ -n "$current_level" && "$current_level" != "0" ]]; then
        pre_idle_level=$current_level
      elif [[ -n "$last_set" && "$last_set" != "0" ]]; then
        pre_idle_level=$last_set
      fi
      apply_brightness 0
      # Must track off so activity re-applies ambient level (was stuck at old level).
      current_level=0
      log "idle ${idle_for}s -> off"
    fi
    [[ "$DRY_RUN" -eq 1 ]] && log "state=$state idle_for=$idle_for"
    wait_while_idle
    continue
  elif [[ "$state" == "IDLE_OFF" ]]; then
    echo "ACTIVE_AUTO" >"$RUNTIME_DIR/state"
    state=ACTIVE_AUTO
    # Instant restore (don't wait for ALS median); ambient loop may refine next ticks.
    if [[ -n "$pre_idle_level" && "$pre_idle_level" != "0" ]]; then
      apply_brightness "$pre_idle_level"
      current_level=$pre_idle_level
    else
      current_level=""
    fi
    log "activity -> auto"
  fi

  if lux=$(kbd_ambient_read_lux "$SYS_ROOT" "$ALS_DEV" 2>/dev/null); then
    als_fail_since=0
  else
    if (( als_fail_since == 0 )); then als_fail_since=$now; fi
    if (( now - als_fail_since > 10 )); then
      lux=99999
    else
      if (( ${#lux_hist[@]} > 0 )); then
        lux="${lux_hist[$(( ${#lux_hist[@]} - 1 ))]}"
      else
        lux=99999
      fi
    fi
  fi

  lux_hist+=("$lux")
  if (( ${#lux_hist[@]} > KBD_AMBIENT_MEDIAN_SAMPLES )); then
    lux_hist=("${lux_hist[@]:$(( ${#lux_hist[@]} - KBD_AMBIENT_MEDIAN_SAMPLES ))}")
  fi
  med=$(kbd_ambient_median "${lux_hist[@]}")

  target=$(kbd_ambient_map_level "$med" "$current_level")
  if [[ "$target" != "$current_level" ]]; then
    apply_brightness "$target"
    current_level=$target
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "state=$state lux=$med target=$target current=$current_level"
  fi

  sleep "$KBD_AMBIENT_POLL_INTERVAL_SEC"
done
